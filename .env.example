# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000
HOST=0.0.0.0

# Database Configuration (Admin / Read-Write Role for Migrations & Ingestion)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fraud_detection
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# Dedicated Read-Only Role for the LangGraph Agent (Defense-in-Depth)
AGENT_DB_USER=agent_reader
AGENT_DB_PASSWORD=agent_reader_password
AGENT_DATABASE_URL=postgresql+asyncpg://agent_reader:agent_reader_password@localhost:5432/fraud_detection

# LLM Provider API Keys (Pick whichever provider is configured)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022
